build lib/N64ModernRuntime/list_install_components: phony


#############################################
# Utility command for install

build lib/N64ModernRuntime/CMakeFiles/install.util: CUSTOM_COMMAND lib/N64ModernRuntime/all
  COMMAND = cd /home/marcelo/projects/WPJ2-recomp/build/lib/N64ModernRuntime && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/N64ModernRuntime/install: phony lib/N64ModernRuntime/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/N64ModernRuntime/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/N64ModernRuntime/all
  COMMAND = cd /home/marcelo/projects/WPJ2-recomp/build/lib/N64ModernRuntime && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/N64ModernRuntime/install/local: phony lib/N64ModernRuntime/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build lib/N64ModernRuntime/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/N64ModernRuntime/all
